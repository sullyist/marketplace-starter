// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String // ✅ New field for hashed password
  role      String    @default("buyer")
  products  Product[]
  orders    Order[]
  resetTokens PasswordResetToken[]
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  sentMessages          Message[]      @relation("SentMessages")
  createdAt DateTime  @default(now())
}

model Product {
  id          String   @id @default(cuid())
  title       String
  make        String   @default("Unknown")
  model       String   @default("Unknown")
  makeModel   String   @default("Unknown")
  year        String   @default("Unknown")
  mileage     String   @default("Unknown")
  mileageUnit String   @default("km")
  condition   String   @default("Unknown")
  description String
  engineSize String @default("Unknown")
  power      String @default("Unknown")
  bikeType   String @default("Unknown")
  price       Float
  imageUrl    String
  location String @default("Unknown")
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())
  orders      Order[]
  conversations Conversation[]
}

model Order {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  buyer     User     @relation(fields: [buyerId], references: [id])
  buyerId   String
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Conversation {
  id        String   @id @default(cuid())
  listing   Product  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  buyer     User     @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId   String
  seller    User     @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId  String
  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

